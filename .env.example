# ─── PuntHub — Betting Prediction Aggregator Environment Variables ───────────
# Copy this file to .env and fill in the values for each gateway you want to use.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
#
# ── Variable types ─────────────────────────────────────────────────────────────
#
#  VITE_*   Browser-side: injected into the Vite bundle at build time.
#           Must also be added as GitHub Repository Secrets for CI/CD.
#
#  (no prefix)  Server-side only: set in your Vercel project environment variables.
#               NEVER add these to GitHub Secrets or expose them in the browser.
#
# ⚠️  Never commit your actual .env file or expose secrets in pull-request logs.

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string for production
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# For local development with SQLite (no server required):
#   DATABASE_URL="file:./dev.db"
#
# For production (set in Vercel environment variables):
DATABASE_URL=

# ── PayPal ─────────────────────────────────────────────────────────────────────
# Create an app at https://developer.paypal.com → My Apps & Credentials
# Use "sb" for sandbox testing, or your live Client ID for production.
VITE_PAYPAL_CLIENT_ID=sb

# ── Coinbase Commerce ──────────────────────────────────────────────────────────
# 1. Create an account at https://commerce.coinbase.com
# 2. Create a "Checkout" (not a charge) in the Commerce dashboard
# 3. Copy the Checkout UUID here
VITE_COINBASE_CHECKOUT_ID=
